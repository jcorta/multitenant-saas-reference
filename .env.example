# Database
POSTGRES_DB=restaurants
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# Schema owner: used by migrations and seed only
DB_OWNER_USER=app_owner
DB_OWNER_PASSWORD=owner_dev_password
# Runtime role: non-owner, subject to Row-Level Security
DB_RUNTIME_USER=app_runtime
DB_RUNTIME_PASSWORD=runtime_dev_password

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_PRIVATE_KEY_PATH=.keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt-public.pem
JWT_ISSUER=restaurant-saas
JWT_AUDIENCE=restaurant-saas-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Seed data (development only)
SEED_PASSWORD=ChangeMe123!

# Web
NUXT_PUBLIC_API_BASE=http://localhost:4000/api
